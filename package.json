{
  "name": "mditor",
  "version": "0.2.0",
  "type": "module",
  "description": "A refined, distraction-free cross-platform Markdown editor with macOS craftsmanship",
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "node scripts/clean.js all",
    "clean:dist": "node scripts/clean.js dist",
    "clean:release": "node scripts/clean.js release",
    "prebuild": "npm run clean:dist",
    "dev": "vite",
    "build": "tsc && vite build",
    "icons": "node scripts/generate-icons.js",
    "prepackage": "npm run clean",
    "package": "npm run build && electron-builder",
    "prepackage:mac": "npm run clean",
    "package:mac": "npm run build && electron-builder --mac",
    "prepackage:mac:arm64": "npm run clean",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "prepackage:win": "npm run clean",
    "package:win": "npm run build && electron-builder --win",
    "prepackage:linux": "npm run clean",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "codemirror",
    "wysiwyg",
    "macos"
  ],
  "author": {
    "name": "chenzhian",
    "email": "monkeychen@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.2",
    "@milkdown/core": "^7.22.3",
    "@milkdown/ctx": "^7.22.3",
    "@milkdown/plugin-history": "^7.22.3",
    "@milkdown/plugin-listener": "^7.22.3",
    "@milkdown/preset-commonmark": "^7.22.3",
    "@milkdown/preset-gfm": "^7.22.3",
    "@milkdown/prose": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@milkdown/transformer": "^7.22.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.51.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.7"
  }
}
